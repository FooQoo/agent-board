{
	# This example runs Caddy in the foreground; keep its admin API disabled.
	admin off
	# This entrypoint is HTTPS-only and must not open the privileged HTTP port.
	auto_https disable_redirects
	# Export the CA root explicitly; never alter this machine's trust stores.
	skip_install_trust
}

https://{$LAN_IP:missing-required-LAN_IP}:{$HTTPS_PORT:missing-required-HTTPS_PORT} {
	# Bind only the chosen LAN interface. For a local test, use 127.0.0.1.
	bind {$LAN_IP:missing-required-LAN_IP}
	tls internal

	# Protect every route, including HTML, assets, APIs, images, and SSE.
	basic_auth {
		{$BASIC_AUTH_USER:missing-required-BASIC_AUTH_USER} {$BASIC_AUTH_HASH:invalid-required-BASIC_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:{$REMOTE_PORT:missing-required-REMOTE_PORT} {
		# The HTTP upstream preserves the incoming Host for the remote Host/Origin guard.
		header_up -Authorization
		# U2 rejects proxy identity headers; do not inject Caddy's default value.
		header_up -X-Forwarded-Host
		flush_interval -1
	}
}
