{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agboard hook --agent claude --plugin-version 1.2.0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agboard hook --agent claude --plugin-version 1.2.0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agboard hook --agent claude --plugin-version 1.2.0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
