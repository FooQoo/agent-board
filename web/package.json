{
  "name": "agent-board-web",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FooQoo/agent-board.git"
  },
  "homepage": "https://github.com/FooQoo/agent-board#readme",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.monitor.config.ts && node scripts/finalize-monitor-build.mjs && node scripts/compress-dist.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "storybook": "storybook dev -p 8610 -h 127.0.0.1 --no-open --ci",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --maxWorkers=1 --no-file-parallelism",
    "verify:story-coverage": "node scripts/verify-story-coverage.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/react": "^0.5.0",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.51.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "12.1.0",
    "nuqs": "^2.10.1",
    "qrcode-generator": "1.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "^30.1.1",
    "jsqr": "1.4.0",
    "playwright": "1.63.0",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
