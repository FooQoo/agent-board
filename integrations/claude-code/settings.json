{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agboard --project 'PROJECT_NAME' hook --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agboard --project 'PROJECT_NAME' hook --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agboard --project 'PROJECT_NAME' hook --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
