{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agboard --project 'PROJECT_NAME' hook --agent codex",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agboard --project 'PROJECT_NAME' hook --agent codex",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
